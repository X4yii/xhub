---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allDocs = await getCollection('docs');
const projectsMap = new Map();

allDocs.forEach(doc => {
    const proj = doc.data.project;
    if (!projectsMap.has(proj)) {
        projectsMap.set(proj, doc);
    } else {
        const existing = projectsMap.get(proj);
        const docCatOrder = doc.data.categoryOrder ?? 99;
        const existingCatOrder = existing.data.categoryOrder ?? 99;
        const docOrder = doc.data.order ?? 99;
        const existingOrder = existing.data.order ?? 99;
        // Prefer lowest non-negative categoryOrder (e.g. 0 = Introduction/Getting Started), then lowest order
        const normDocCat = docCatOrder < 0 ? 50 : docCatOrder;
        const normExCat = existingCatOrder < 0 ? 50 : existingCatOrder;
        if (normDocCat < normExCat || (normDocCat === normExCat && docOrder < existingOrder)) {
            projectsMap.set(proj, doc);
        }
    }
});

const projectMeta: Record<string, { tag: string; es: string; en: string }> = {
    ModularVoiceX4yi: {
        tag: 'Audio / PipeWire / Rust',
        es: 'Manual de instalación, TUI/CLI, rack DSP, supresión neuronal DeepFilterNet3, biometría CAM++ y clonación OpenVoice V2.',
        en: 'Installation guide, TUI/CLI reference, DSP rack, DeepFilterNet3 denoiser, CAM++ biometrics, and OpenVoice V2 cloning.'
    },
    X4UI: {
        tag: 'GUI Framework',
        es: 'Documentación de arquitectura DOM retenida, FlexLayout, IGraphics, tipografía TrueType, estados reactivos y video Zero-Copy.',
        en: 'Retained DOM architecture, FlexLayout, IGraphics, TrueType typography, reactive states, and Zero-Copy video documentation.'
    },
    LethalWeaponry: {
        tag: 'Minecraft Mod',
        es: 'Guía de usuario, armas (WarHammer, Katana, Scythe, Chain Blade), encantamientos, fórmulas matemáticas y configuración JSON.',
        en: 'User guide, weapons (WarHammer, Katana, Scythe, Chain Blade), enchantments, math formulas, and JSON configuration.'
    }
};

const projects = Array.from(projectsMap.values());
---
<Layout
  title="Documentación | XHub — X4yi"
  description="Documentación oficial de los proyectos de X4yi: ModularVoiceX4yi (MVX), X4UI Framework y LethalWeaponry Mod."
  keywords="X4yi, x4ui, ModularVoiceX4yi docs, MVX docs, X4UI docs, LethalWeaponry docs, PipeWire, Forge 1.12.2"
>
  <main class="container">
    <header class="section-header">
        <h1>
            <span data-i18n="es">Documentación</span>
            <span data-i18n="en">Documentation</span>
        </h1>
        <p>
            <span data-i18n="es">Selecciona un proyecto para leer su manual oficial.</span>
            <span data-i18n="en">Select a project to read its official manual.</span>
        </p>
    </header>
    <div class="card-grid">
      {projects.map(doc => {
        const meta = projectMeta[doc.data.project] || {
            tag: 'Project',
            es: 'Documentación oficial.',
            en: 'Official documentation.'
        };
        return (
          <a href={`/xhub/docs/${doc.id}/`} class="doc-card">
              <span class="project-tag">{meta.tag}</span>
              <h2>{doc.data.project} &rarr;</h2>
              <p class="proj-desc">
                  <span data-i18n="es">{meta.es}</span>
                  <span data-i18n="en">{meta.en}</span>
              </p>
          </a>
        );
      })}
    </div>
  </main>
</Layout>
<style>
  .container { max-width: 1100px; margin: 4rem auto; padding: 0 2rem; min-height: 70vh; }
  .section-header { margin-bottom: 3rem; }
  h1 { color: var(--text-primary); font-size: 3rem; margin-bottom: 0.5rem; letter-spacing: -0.03em; }
  p { color: var(--text-secondary); font-size: 1.1rem; }
  .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.5rem;
  }
  .doc-card {
      display: block;
      padding: 1.5rem;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 12px;
      text-decoration: none;
      transition: all 0.2s ease;
  }
  .doc-card:hover {
      background: rgba(255, 255, 255, 0.05);
      border-color: var(--accent-docs);
      transform: translateY(-4px);
  }
  .project-tag {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--accent-docs);
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
      display: inline-block;
  }
  .doc-card h2 {
      color: var(--text-primary);
      font-size: 1.5rem;
      margin: 0 0 0.5rem 0;
  }
  .proj-desc {
      color: var(--text-secondary);
      font-size: 0.95rem;
      margin: 0;
      line-height: 1.6;
  }

  @media (max-width: 768px) {
    .container { padding: 0 1rem; margin: 2rem auto; }
    h1 { font-size: 2.2rem; }
    .card-grid { grid-template-columns: 1fr; }
  }
</style>
