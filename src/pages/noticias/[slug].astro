---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Layout title={`XHub - ${entry.data.title}`}>
  <main class="container">
    <a href="/xhub/noticias/" class="back-link">&larr; Volver a Noticias</a>
    <article class="article-content glass-panel" >
        <header class="doc-header">
            <span class="project-tag">{entry.data.date.toLocaleDateString()}</span>
            <h1>{entry.data.title}</h1>
        </header>
        <div class="content-wrapper">
          <Content />
        </div>
    </article>
  </main>
</Layout>
<style>
  .container { max-width: 900px; margin: 4rem auto; padding: 0 2rem; min-height: 70vh; }
  .back-link { color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; margin-bottom: 2rem; display: inline-block; transition: color 0.2s; }
  .back-link:hover { color: var(--text-primary); }
  .doc-header { margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
  .project-tag { font-size: 0.85rem; font-weight: bold; text-transform: uppercase; color: var(--accent-news); letter-spacing: 0.05em; }
  .doc-header h1 { font-size: 3rem; color: var(--text-primary); margin-top: 0.5rem; letter-spacing: -0.03em; }
  .content-wrapper { color: var(--text-secondary); line-height: 1.8; font-size: 1.1rem; }
  :global(.content-wrapper h1, .content-wrapper h2, .content-wrapper h3) { color: var(--text-primary); margin-top: 2.5rem; margin-bottom: 1rem; }
  :global(.content-wrapper p) { margin-bottom: 1.5rem; }
  :global(.content-wrapper ul, .content-wrapper ol) { margin-bottom: 1.5rem; padding-left: 2rem; }
  :global(.content-wrapper li) { margin-bottom: 0.5rem; }
  :global(.content-wrapper pre) { background: rgba(0,0,0,0.3) !important; padding: 1.5rem; border-radius: 8px; overflow-x: auto; margin: 2rem 0; border: 1px solid rgba(255,255,255,0.05); }
  :global(.content-wrapper code) { font-family: 'Courier New', Courier, monospace; color: var(--accent-docs); background: rgba(255,255,255,0.05); padding: 0.1rem 0.3rem; border-radius: 4px; }
  :global(.content-wrapper pre code) { background: none; color: #e5e7eb; padding: 0; }
  :global(.content-wrapper strong) { color: var(--text-primary); }
  :global(.content-wrapper hr) { border: none; border-top: 1px solid var(--border); margin: 3rem 0; }
</style>