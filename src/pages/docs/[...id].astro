---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import TOC from '../../components/TOC.astro';
import CarbonAds from '../../components/CarbonAds.astro';
export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map(entry => ({
    params: { id: entry.id }, props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const currentProject = entry.data.project;
---
<Layout title={`XHub - ${entry.data.title}`} type="article" url={`https://x4yi.github.io/docs/${entry.id}`}>
  <div class="docs-layout">
    <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Abrir navegación">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18"/><path d="M3 6h18"/><path d="M3 18h18"/></svg>
      {entry.data.project}
    </button>
    <div class="sidebar-overlay" id="sidebar-overlay"></div>
    <Sidebar currentProject={currentProject} currentId={entry.id} />
    <main class="docs-content-area">
      <header class="doc-header">
          <span class="category-tag">{entry.data.category}</span>
          <h1>{entry.data.title}</h1>
      </header>
      <div class="content-wrapper prose">
        <Content />
      </div>
    </main>
    <aside class="toc-sidebar">
      {headings.length > 0 && <TOC headings={headings} />}
      <CarbonAds />
    </aside>
  </div>
</Layout>

<script is:inline>
  const toggle = document.getElementById('sidebar-toggle');
  const overlay = document.getElementById('sidebar-overlay');
  const sidebar = document.querySelector('.sidebar');

  function openSidebar() {
    sidebar.classList.add('mobile-open');
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeSidebar() {
    sidebar.classList.remove('mobile-open');
    overlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  if (toggle) toggle.addEventListener('click', openSidebar);
  if (overlay) overlay.addEventListener('click', closeSidebar);

  document.querySelectorAll('.sidebar .nav-links a').forEach(link => {
    link.addEventListener('click', closeSidebar);
  });
</script>

<style>
  .docs-layout {
      display: grid;
      grid-template-columns: 280px 1fr 250px;
      max-width: 1500px;
      margin: 0 auto;
      min-height: calc(100vh - 70px);
      position: relative;
  }
  .sidebar-toggle { display: none; }
  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(4px);
    z-index: 90;
  }
  .sidebar-overlay.active { display: block; }
  .docs-content-area {
      padding: 3rem 4rem;
      max-width: 900px;
  }
  .toc-sidebar {
      padding: 3rem 1.5rem 3rem 0;
  }
  .doc-header { margin-bottom: 3rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
  .category-tag { font-size: 0.85rem; font-weight: bold; text-transform: uppercase; color: var(--accent-docs); letter-spacing: 0.05em; }
  .doc-header h1 { font-size: 3rem; color: var(--text-primary); margin-top: 0.5rem; letter-spacing: -0.03em; }
  .prose { color: var(--text-secondary); line-height: 1.8; font-size: 1.05rem; }
  :global(.prose h1, .prose h2, .prose h3) { color: var(--text-primary); margin-top: 2.5rem; margin-bottom: 1rem; scroll-margin-top: 100px; }
  :global(.prose p) { margin-bottom: 1.5rem; }
  :global(.prose ul, .prose ol) { margin-bottom: 1.5rem; padding-left: 2rem; }
  :global(.prose li) { margin-bottom: 0.5rem; }
  :global(.prose pre) { background: rgba(0,0,0,0.3) !important; padding: 1.5rem; border-radius: 8px; overflow-x: auto; margin: 2rem 0; border: 1px solid rgba(255,255,255,0.05); }
  :global(.prose code) { font-family: 'Courier New', Courier, monospace; color: var(--accent-news); background: rgba(255,255,255,0.05); padding: 0.1rem 0.3rem; border-radius: 4px; }
  :global(.prose pre code) { background: none; color: #e5e7eb; padding: 0; }
  :global(.prose strong) { color: var(--text-primary); }
  :global(.prose hr) { border: none; border-top: 1px solid var(--border); margin: 3rem 0; }
  :global(.prose img) { max-width: 100%; height: auto; border-radius: 8px; margin: 1.5rem 0; display: block; box-shadow: 0 4px 15px rgba(0,0,0,0.3); }

  @media (max-width: 1200px) {
      .docs-layout { grid-template-columns: 250px 1fr; }
      .toc-sidebar { display: none; }
  }
  @media (max-width: 900px) {
      .docs-layout {
          display: flex;
          flex-direction: column;
      }
      .docs-content-area {
          padding: 1.5rem 1.25rem;
          max-width: 100%;
      }
      .doc-header h1 { font-size: 2rem; }
      .sidebar-toggle {
          display: flex;
          align-items: center;
          gap: 0.6rem;
          background: rgba(255,255,255,0.04);
          border: 1px solid var(--border);
          color: var(--text-secondary);
          padding: 0.6rem 1rem;
          margin: 1rem 1.25rem 0;
          border-radius: 8px;
          cursor: pointer;
          font-size: 0.9rem;
          font-weight: 500;
          transition: all 0.2s;
          width: calc(100% - 2.5rem);
      }
      .sidebar-toggle:hover {
          color: var(--text-primary);
          background: rgba(255,255,255,0.07);
          border-color: var(--accent-docs);
      }
      :global(.sidebar) {
          position: fixed !important;
          top: 0;
          left: 0;
          height: 100dvh !important;
          z-index: 95;
          transform: translateX(-100%);
          transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
          border-right: 1px solid var(--border) !important;
          width: 280px !important;
      }
      :global(.sidebar.mobile-open) {
          transform: translateX(0);
      }
  }
</style>